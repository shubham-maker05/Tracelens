<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon (Android 13+) variant — same pin+lens silhouette, flattened to
  one solid colour since a themed icon has no palette of its own to spend.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Lens cut out as a hole in the pin using evenOdd so it reads as a ring, not a solid blob -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M54,11 C37.5,11 24,24.5 24,41 C24,64 54,97 54,97 C54,97 84,64 84,41 C84,24.5 70.5,11 54,11 Z
                           M54,40 m-16,0 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0" />
    <path android:fillColor="#FFFFFFFF" android:pathData="M54,40 m-6.5,0 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0" />
</vector>
